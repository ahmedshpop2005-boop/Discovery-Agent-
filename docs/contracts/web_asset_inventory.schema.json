      "properties": {
        "application_id": {
          "title": "Application Id",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/ObservationBasis",
