        },
        "waf": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waf"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "application_id",
        "origin"
      ],
      "title": "WebApplication",
      "type": "object"
    },
    "WebObservationProvenance": {
      "additionalProperties": false,
      "description": "Provenance that also names the URL/path the observation came from.",
      "properties": {
        "observation_id": {
          "title": "Observation Id",
          "type": "string"
        },
        "source_tool": {
          "title": "Source Tool",
          "type": "string"
        },
        "tool_version": {
          "default": "1.0",
