          "type": "string"
        },
        "runner_id": {
          "title": "Runner Id",
          "type": "string"
        },
        "identity": {
          "default": "external-probe",
          "title": "Identity",
          "type": "string"
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentKind"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        }
      },
      "required": [
        "observation_id",
        "source_tool",
        "runner_id",
        "environment",
        "observed_at"
      ],
      "title": "WebObservationProvenance",
      "type": "object"
    },
