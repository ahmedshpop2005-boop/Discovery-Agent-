{
  "$defs": {
    "ConfidenceLevel": {
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "VerificationStatus": {
      "enum": [
        "unverified",
        "verified",
        "package_verified",
        "rejected",
        "unknown"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A traceable piece of evidence behind an asset/service/route observation.",
  "properties": {
    "evidence_id": {
      "title": "Evidence Id",
      "type": "string"
    },
    "type": {
      "title": "Type",
      "type": "string"
    },
    "source_tool": {
      "title": "Source Tool",
      "type": "string"
    },
    "target": {
      "title": "Target",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status"
    },
    "snippet": {
      "default": "",
      "title": "Snippet",
      "type": "string"
    },
    "observed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed At"
    },
    "confidence": {
      "$ref": "#/$defs/ConfidenceLevel",
      "default": "unknown"
    },
    "verification_status": {
      "$ref": "#/$defs/VerificationStatus",
      "default": "unverified"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    }
  },
  "required": [
    "evidence_id",
    "type",
    "source_tool",
    "target"
  ],
  "title": "EvidenceRecord",
  "type": "object"
}