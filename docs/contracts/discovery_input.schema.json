{
  "$defs": {
    "AccessProfile": {
      "additionalProperties": false,
      "description": "An available identity / privilege set.\n\nSecret material stays outside the model: only a protected ``secret_ref``\nmay be carried (contract: \"Secret material stays outside model context\").",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "external-probe",
          "title": "Kind",
          "type": "string"
        },
        "authenticated": {
          "default": false,
          "title": "Authenticated",
          "type": "boolean"
        },
        "privileges": {
          "items": {
            "type": "string"
          },
          "title": "Privileges",
          "type": "array"
        },
        "secret_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secret Ref"
        }
      },
      "required": [
        "id"
      ],
      "title": "AccessProfile",
      "type": "object"
    },
    "CommonInput": {
      "additionalProperties": false,
      "description": "Fields present in the input of every role.",
      "properties": {
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "environment_id": {
          "title": "Environment Id",
          "type": "string"
        },
        "environment_kind": {
          "$ref": "#/$defs/EnvironmentKind"
        },
        "objective": {
          "title": "Objective",
          "type": "string"
        },
        "selected_stages": {
          "items": {
            "type": "string"
          },
          "title": "Selected Stages",
          "type": "array"
        },
        "scope_ref": {
          "$ref": "#/$defs/ScopeRef"
        },
        "context_refs": {
          "items": {
            "type": "string"
          },
          "title": "Context Refs",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "available_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Available Capabilities",
          "type": "array"
        },
        "remaining_budget": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Remaining Budget",
          "type": "object"
        }
      },
      "required": [
        "workspace_id",
        "run_id",
        "task_id",
        "environment_id",
        "environment_kind",
        "objective",
        "scope_ref"
      ],
      "title": "CommonInput",
      "type": "object"
    },
    "DiscoveryLimits": {
      "additionalProperties": false,
      "properties": {
        "ports": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ports"
        },
        "protocols": {
          "items": {
            "type": "string"
          },
          "title": "Protocols",
          "type": "array"
        },
        "methods": {
          "items": {
            "type": "string"
          },
          "title": "Methods",
          "type": "array"
        },
        "scan_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scan Rate"
        },
        "concurrency": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Concurrency"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        }
      },
      "title": "DiscoveryLimits",
      "type": "object"
    },
    "EnvironmentKind": {
      "enum": [
        "REAL",
        "TWIN"
      ],
      "title": "EnvironmentKind",
      "type": "string"
    },
    "NetworkContext": {
      "additionalProperties": false,
      "properties": {
        "runner_id": {
          "title": "Runner Id",
          "type": "string"
        },
        "source_network": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Network"
        },
        "known_topology": {
          "items": {
            "type": "string"
          },
          "title": "Known Topology",
          "type": "array"
        }
      },
      "required": [
        "runner_id"
      ],
      "title": "NetworkContext",
      "type": "object"
    },
    "ScopeRef": {
      "additionalProperties": false,
      "description": "Reference to the current versioned authorization and scope.",
      "properties": {
        "scope_id": {
          "title": "Scope Id",
          "type": "string"
        },
        "version": {
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "targets": {
          "items": {
            "type": "string"
          },
          "title": "Targets",
          "type": "array"
        },
        "permitted_effects": {
          "items": {
            "type": "string"
          },
          "title": "Permitted Effects",
          "type": "array"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        }
      },
      "required": [
        "scope_id"
      ],
      "title": "ScopeRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Discover from authorized seeds within declared limits.",
  "properties": {
    "common": {
      "$ref": "#/$defs/CommonInput"
    },
    "target_seeds": {
      "items": {
        "type": "string"
      },
      "title": "Target Seeds",
      "type": "array"
    },
    "discovery_limits": {
      "$ref": "#/$defs/DiscoveryLimits"
    },
    "known_inventory_refs": {
      "items": {
        "type": "string"
      },
      "title": "Known Inventory Refs",
      "type": "array"
    },
    "access_profiles": {
      "items": {
        "$ref": "#/$defs/AccessProfile"
      },
      "title": "Access Profiles",
      "type": "array"
    },
    "network_context": {
      "$ref": "#/$defs/NetworkContext"
    },
    "discovery_questions": {
      "items": {
        "type": "string"
      },
      "title": "Discovery Questions",
      "type": "array"
    }
  },
  "required": [
    "common",
    "network_context"
  ],
  "title": "DiscoveryInput",
  "type": "object"
}