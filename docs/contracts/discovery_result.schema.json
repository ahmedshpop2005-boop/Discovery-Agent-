{
  "$defs": {
    "AgentStatus": {
      "description": "Lifecycle status of a role task (common output ``status``).",
      "enum": [
        "DONE",
        "MORE_WORK",
        "BLOCKED",
        "NEEDS_REVIEW",
        "FAILED"
      ],
      "title": "AgentStatus",
      "type": "string"
    },
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "identity": {
          "title": "Identity",
          "type": "string"
        },
        "addresses": {
          "items": {
            "type": "string"
          },
          "title": "Addresses",
          "type": "array"
        },
        "os": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Os"
        },
        "os_basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservationBasis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "asset_id",
        "identity"
      ],
      "title": "Asset",
      "type": "object"
    },
    "AssetInventory": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/Asset"
          },
          "title": "Assets",
          "type": "array"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/ServiceRecord"
          },
          "title": "Services",
          "type": "array"
        },
        "host_observations": {
          "items": {
            "$ref": "#/$defs/HostObservation"
          },
          "title": "Host Observations",
          "type": "array"
        },
        "relationship_proposals": {
          "items": {
            "$ref": "#/$defs/RelationshipProposal"
          },
          "title": "Relationship Proposals",
          "type": "array"
        },
        "observation_provenance": {
          "items": {
            "$ref": "#/$defs/ObservationProvenance"
          },
          "title": "Observation Provenance",
          "type": "array"
        },
        "uncertainties": {
          "items": {
            "$ref": "#/$defs/Uncertainty"
          },
          "title": "Uncertainties",
          "type": "array"
        },
        "unassessed_targets": {
          "items": {
            "$ref": "#/$defs/UnassessedTarget"
          },
          "title": "Unassessed Targets",
          "type": "array"
        }
      },
      "title": "AssetInventory",
      "type": "object"
    },
    "AuthenticationCoverage": {
      "additionalProperties": false,
      "description": "What was and was not assessed regarding authenticated/role surfaces.",
      "properties": {
        "status": {
          "default": "not_assessed",
          "title": "Status",
          "type": "string"
        },
        "profiles_supplied": {
          "default": 0,
          "title": "Profiles Supplied",
          "type": "integer"
        },
        "authenticated_profiles": {
          "default": 0,
          "title": "Authenticated Profiles",
          "type": "integer"
        },
        "checks_completed": {
          "items": {
            "type": "string"
          },
          "title": "Checks Completed",
          "type": "array"
        },
        "checks_unverified": {
          "items": {
            "type": "string"
          },
          "title": "Checks Unverified",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "title": "AuthenticationCoverage",
      "type": "object"
    },
    "CommonOutput": {
      "additionalProperties": false,
      "description": "Fields present in the output of every role.",
      "properties": {
        "status": {
          "$ref": "#/$defs/AgentStatus"
        },
        "artifact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Refs",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "proposed_actions": {
          "items": {
            "$ref": "#/$defs/ProposedAction"
          },
          "title": "Proposed Actions",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "coverage_gaps": {
          "items": {
            "type": "string"
          },
          "title": "Coverage Gaps",
          "type": "array"
        },
        "required_gate": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequiredGate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "concise_rationale": {
          "title": "Concise Rationale",
          "type": "string"
        },
        "next_objective": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Objective"
        }
      },
      "required": [
        "status",
        "concise_rationale"
      ],
      "title": "CommonOutput",
      "type": "object"
    },
    "ConfidenceLevel": {
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "CoverageStatus": {
      "enum": [
        "full",
        "partial",
        "limited",
        "unknown"
      ],
      "title": "CoverageStatus",
      "type": "string"
    },
    "EndpointRecord": {
      "additionalProperties": false,
      "description": "A route/template observed on the wire or declared by a spec.\n\n``observed`` is ``True`` only when the endpoint was actually requested and\nanswered. Routes declared by robots.txt/sitemap/OpenAPI but not requested\nare ``observed=False`` (spec-only) and are never inferred to be vulnerable.",
      "properties": {
        "endpoint_id": {
          "title": "Endpoint Id",
          "type": "string"
        },
        "application_id": {
          "title": "Application Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "method": {
          "default": "GET",
          "title": "Method",
          "type": "string"
        },
        "parameters": {
          "items": {
            "type": "string"
          },
          "title": "Parameters",
          "type": "array"
        },
        "forms": {
          "items": {
            "$ref": "#/$defs/FormRecord"
          },
          "title": "Forms",
          "type": "array"
        },
        "api_operation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Operation"
        },
        "observed": {
          "default": true,
          "title": "Observed",
          "type": "boolean"
        },
        "status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "classification": {
          "default": "unknown",
          "title": "Classification",
          "type": "string"
        },
        "collection_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collection Method"
        },
        "source": {
          "default": "unknown",
          "title": "Source",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "endpoint_id",
        "application_id",
        "path"
      ],
      "title": "EndpointRecord",
      "type": "object"
    },
    "EnvironmentKind": {
      "enum": [
        "REAL",
        "TWIN"
      ],
      "title": "EnvironmentKind",
      "type": "string"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "description": "A traceable piece of evidence behind an asset/service/route observation.",
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "source_tool": {
          "title": "Source Tool",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "snippet": {
          "default": "",
          "title": "Snippet",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceLevel",
          "default": "unknown"
        },
        "verification_status": {
          "$ref": "#/$defs/VerificationStatus",
          "default": "unverified"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "type",
        "source_tool",
        "target"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "FormRecord": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "default": "",
          "title": "Action",
          "type": "string"
        },
        "method": {
          "default": "GET",
          "title": "Method",
          "type": "string"
        },
        "parameters": {
          "items": {
            "type": "string"
          },
          "title": "Parameters",
          "type": "array"
        }
      },
      "title": "FormRecord",
      "type": "object"
    },
    "HostObservation": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/ObservationBasis",
          "default": "configuration"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "asset_id",
        "category",
        "key",
        "value"
      ],
      "title": "HostObservation",
      "type": "object"
    },
    "ObservationBasis": {
      "description": "How an observation was obtained.\n\n``BANNER`` means an advertised/unauthenticated string. It must not be\ntreated as authenticated package evidence (see the Networking example:\n\"Label the version as a banner observation until authenticated package\nevidence supports it\").",
      "enum": [
        "banner",
        "authenticated-package",
        "configuration",
        "inferred"
      ],
      "title": "ObservationBasis",
      "type": "string"
    },
    "ObservationProvenance": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "title": "Observation Id",
          "type": "string"
        },
        "source_tool": {
          "title": "Source Tool",
          "type": "string"
        },
        "tool_version": {
          "default": "1.0",
          "title": "Tool Version",
          "type": "string"
        },
        "runner_id": {
          "title": "Runner Id",
          "type": "string"
        },
        "identity": {
          "default": "external-probe",
          "title": "Identity",
          "type": "string"
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentKind"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "source_tool",
        "runner_id",
        "environment",
        "observed_at"
      ],
      "title": "ObservationProvenance",
      "type": "object"
    },
    "ProposedAction": {
      "additionalProperties": false,
      "description": "A typed proposal naming a registered capability and its inputs.",
      "properties": {
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "capability_version": {
          "default": "1.0",
          "title": "Capability Version",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "asset_ids": {
          "items": {
            "type": "string"
          },
          "title": "Asset Ids",
          "type": "array"
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentKind"
        },
        "parameter_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameter Ref"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "dependency_ids": {
          "items": {
            "type": "string"
          },
          "title": "Dependency Ids",
          "type": "array"
        },
        "cleanup_plan_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cleanup Plan Ref"
        }
      },
      "required": [
        "capability",
        "stage",
        "environment"
      ],
      "title": "ProposedAction",
      "type": "object"
    },
    "Reachability": {
      "enum": [
        "REACHABLE",
        "FILTERED",
        "UNREACHABLE",
        "UNKNOWN"
      ],
      "title": "Reachability",
      "type": "string"
    },
    "RelationshipKind": {
      "enum": [
        "observed",
        "inferred"
      ],
      "title": "RelationshipKind",
      "type": "string"
    },
    "RelationshipProposal": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/RelationshipKind",
          "default": "observed"
        },
        "from_ref": {
          "title": "From Ref",
          "type": "string"
        },
        "to_ref": {
          "title": "To Ref",
          "type": "string"
        },
        "relation": {
          "title": "Relation",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "from_ref",
        "to_ref",
        "relation"
      ],
      "title": "RelationshipProposal",
      "type": "object"
    },
    "RequiredGate": {
      "description": "External gate a result is waiting on, or ``None`` when none is needed.",
      "enum": [
        "INPUT",
        "AUTHORIZATION",
        "APPROVAL",
        "REVIEW"
      ],
      "title": "RequiredGate",
      "type": "string"
    },
    "RouteCoverage": {
      "additionalProperties": false,
      "description": "Honest route-discovery coverage summary.\n\n``coverage_status`` is never ``full`` merely because every configured\ncandidate was attempted: access-control responses, CDN pages, missing\nauthentication and tool failures force ``limited``/``partial``.",
      "properties": {
        "routes_attempted": {
          "default": 0,
          "title": "Routes Attempted",
          "type": "integer"
        },
        "routes_confirmed": {
          "default": 0,
          "title": "Routes Confirmed",
          "type": "integer"
        },
        "routes_inaccessible": {
          "default": 0,
          "title": "Routes Inaccessible",
          "type": "integer"
        },
        "routes_failed": {
          "default": 0,
          "title": "Routes Failed",
          "type": "integer"
        },
        "routes_untested": {
          "default": 0,
          "title": "Routes Untested",
          "type": "integer"
        },
        "coverage_status": {
          "$ref": "#/$defs/CoverageStatus",
          "default": "unknown"
        },
        "coverage_limitations": {
          "items": {
            "type": "string"
          },
          "title": "Coverage Limitations",
          "type": "array"
        },
        "methods_executed": {
          "items": {
            "type": "string"
          },
          "title": "Methods Executed",
          "type": "array"
        },
        "methods_skipped": {
          "items": {
            "type": "string"
          },
          "title": "Methods Skipped",
          "type": "array"
        }
      },
      "title": "RouteCoverage",
      "type": "object"
    },
    "RuntimeBinding": {
      "additionalProperties": false,
      "description": "Trusted-runtime identifiers that accompany every stored result.\n\nThe model cannot change these; the runtime assigns or verifies them.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "environment_id": {
          "title": "Environment Id",
          "type": "string"
        },
        "agent_id": {
          "default": "discovery",
          "title": "Agent Id",
          "type": "string"
        },
        "model_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Call Id"
        }
      },
      "required": [
        "workspace_id",
        "run_id",
        "environment_id"
      ],
      "title": "RuntimeBinding",
      "type": "object"
    },
    "ServiceRecord": {
      "additionalProperties": false,
      "properties": {
        "service_id": {
          "title": "Service Id",
          "type": "string"
        },
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "port": {
          "title": "Port",
          "type": "integer"
        },
        "transport": {
          "default": "tcp",
          "title": "Transport",
          "type": "string"
        },
        "name": {
          "default": "unknown",
          "title": "Name",
          "type": "string"
        },
        "product": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "version_basis": {
          "$ref": "#/$defs/ObservationBasis",
          "default": "banner"
        },
        "authenticated": {
          "default": false,
          "title": "Authenticated",
          "type": "boolean"
        },
        "reachability": {
          "$ref": "#/$defs/Reachability",
          "default": "REACHABLE"
        },
        "uncertainty": {
          "items": {
            "type": "string"
          },
          "title": "Uncertainty",
          "type": "array"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "service_id",
        "asset_id",
        "port"
      ],
      "title": "ServiceRecord",
      "type": "object"
    },
    "TechnologyObservationType": {
      "description": "How a technology/version was obtained.\n\nOnly ``VERSION_VERIFIED`` (independent validation) and\n``PACKAGE_VERIFIED`` (authenticated package inventory) may ever be\npresented as verified; everything derived from HTML, JavaScript, banners\nor HTTP headers stays a claim/fingerprint.",
      "enum": [
        "fingerprint_observed",
        "banner_observed",
        "version_claimed",
        "version_verified",
        "package_verified",
        "unknown"
      ],
      "title": "TechnologyObservationType",
      "type": "string"
    },
    "TechnologyRecord": {
      "additionalProperties": false,
      "description": "Normalised technology observation.\n\nThe normaliser never promotes arbitrary metadata (country names, IPs,\nheader directives, MIME types) to a version. HTML/JS/banner/header values\nare ``version_claimed``/``banner_observed`` and remain ``unverified``\nunless an independent check validated them.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "observation_type": {
          "$ref": "#/$defs/TechnologyObservationType",
          "default": "fingerprint_observed"
        },
        "verification_status": {
          "$ref": "#/$defs/VerificationStatus",
          "default": "unverified"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceLevel",
          "default": "low"
        },
        "basis": {
          "$ref": "#/$defs/ObservationBasis",
          "default": "banner"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "collection_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collection Method"
        },
