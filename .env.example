# Optional LLM reasoning (OpenAI-compatible). Leave blank to run fully offline.
# When APS_LLM_API_KEY (or OPENAI_API_KEY) is set, the Discovery planner asks the
# model to choose among the registered, profile-eligible tools. Without a key the
# agent uses its deterministic planner and never calls out.

# APS_LLM_API_KEY=sk-...
# APS_LLM_BASE_URL=https://api.openai.com/v1
# APS_LLM_MODEL=gpt-4o-mini
# APS_LLM_TIMEOUT=30
# APS_LLM_RETRIES=2

# APS_LLM_MODEL may be a comma-separated chain: a busy model (transient 503)
# automatically falls through to the next one.
#   APS_LLM_MODEL=gemini-flash-latest,gemini-3.5-flash

# Optional secondary provider, tried automatically when the primary fails
# (unreachable / rate limited). Handy as a local Ollama safety net.
#   APS_LLM_FALLBACK_BASE_URL=http://127.0.0.1:11434/v1
#   APS_LLM_FALLBACK_API_KEY=ollama
#   APS_LLM_FALLBACK_MODEL=qwen2.5:7b

# Point at any OpenAI-compatible gateway instead, e.g.:
#   Gemini     : https://generativelanguage.googleapis.com/v1beta/openai/  (model: gemini-flash-latest)
#   OpenRouter : https://openrouter.ai/api/v1
#   Groq       : https://api.groq.com/openai/v1
#   Ollama     : http://127.0.0.1:11434/v1   (model: llama3.2, key can be any value)
